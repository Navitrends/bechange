# Application
APP_NAME=Bricodari Price Intelligence
APP_ENV=development
SECRET_KEY=change-me-in-production

# Database (SQLite local by default — switch to PostgreSQL later)
DATABASE_URL=sqlite:///./bricodari.db
# DATABASE_URL=postgresql+psycopg2://bricodari:bricodari@localhost:5432/bricodari_prices

# Redis (optional for now)
REDIS_URL=redis://localhost:6379/0

# WooCommerce — https://bricodari.tn
WOOCOMMERCE_URL=https://bricodari.tn
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Sync automatique catalogue (heures)
WOO_SYNC_ENABLED=true
WOO_SYNC_INTERVAL_HOURS=6

# Google Drive (Phase 3+)
GOOGLE_DRIVE_CREDENTIALS_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# Upload
UPLOAD_DIR=./uploads
